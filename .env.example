# Optional local/app-level fallback for real LLM-powered reviews.
# The Streamlit page can also accept a visitor's session-only API Key.
OPENAI_API_KEY=your_opencode_go_api_key_here

# Optional settings
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
CODE_REVIEW_MODEL=gpt-5.6-luna
CODE_REVIEW_MAX_FILES=30
CODE_REVIEW_MAX_CHARS=50000

# Optional protection for a public Streamlit Demo
DEMO_ACCESS_PASSWORD=
DEMO_MAX_REVIEWS_PER_SESSION=10
